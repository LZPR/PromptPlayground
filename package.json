{
  "name": "prompt-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tauri": "node ./node_modules/@tauri-apps/cli/tauri.js",
    "tauri:dev": "node ./node_modules/@tauri-apps/cli/tauri.js dev",
    "tauri:build": "node ./node_modules/@tauri-apps/cli/tauri.js build",
    "android:init": "node ./node_modules/@tauri-apps/cli/tauri.js android init",
    "android:dev": "node ./node_modules/@tauri-apps/cli/tauri.js android dev",
    "android:build": "node ./node_modules/@tauri-apps/cli/tauri.js android build",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-sql": "^2.0.0",
    "@vueuse/core": "^12.0.0",
    "dompurify": "^3.2.0",
    "element-plus": "^2.9.0",
    "markdown-it": "^14.1.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.50.0",
    "@tauri-apps/cli": "^2.0.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.10.0",
    "@types/dompurify": "^3.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
